# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=unitreasury
DB_SSLMODE=disable
DATABASE_URL=postgres://your_db_user:your_db_password@127.0.0.1:5433/unitreasury?sslmode=disable

# Backend API Configuration
PORT=8081
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRATION_HOURS=24

# Blockchain Network Configuration
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ETHERSCAN_API_KEY=your_etherscan_api_key

# Smart Contract Addresses (Update after deployment)
TREASURY_CONTRACT_ADDRESS=0x...
FEE_REGISTRY_CONTRACT_ADDRESS=0x...
SCHOLARSHIP_ESCROW_CONTRACT_ADDRESS=0x...
MOCK_USDC_ADDRESS=0x...
MOCK_LZ_ENDPOINT_ADDRESS=0x...

# Gasless Transactions (Feature 2)
ENTRYPOINT_ADDRESS=0x...
PAYMASTER_ADDRESS=0x...

# ZK Identity (Feature 4)
ZK_VERIFIER_ADDRESS=0x...
ZK_REGISTRY_ADDRESS=0x...

# Administrative / System Wallets
ATTESTOR_PRIVATE_KEY=your_private_key_here
