# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://unitreasury:password@localhost:5432/unitreasury?sslmode=disable

# Blockchain
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=11155111

# Contract addresses (populated by forge script output)
TREASURY_CONTRACT_ADDRESS=0x...
FEE_REGISTRY_CONTRACT_ADDRESS=0x...
SCHOLARSHIP_ESCROW_CONTRACT_ADDRESS=0x...

# Attestor key (EIP-712 signing key — backend service wallet)
ATTESTOR_PRIVATE_KEY=0x...

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24

# Event indexer
INDEXER_START_BLOCK=0
INDEXER_POLL_INTERVAL_SECONDS=15
INDEXER_BATCH_SIZE=100
